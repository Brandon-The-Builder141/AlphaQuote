# AlphaQuote Project .gitattributes
# Ensure consistent line endings across different operating systems

# ===========================================
# Line Endings
# ===========================================
# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ===========================================
# Binary Files
# ===========================================
# Declare files that will always have CRLF line endings on checkout
*.sln text eol=crlf

# Declare files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
*.pyc binary
*.pdf binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# ===========================================
# Language Specific
# ===========================================
# Python
*.py text eol=lf
*.pyi text eol=lf
*.pyx text eol=lf
*.pyo binary
*.pyd binary

# Node.js
package.json text eol=lf
package-lock.json text eol=lf
yarn.lock text eol=lf
*.lock text eol=lf

# React/JSX
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# CSS
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf

# HTML
*.html text eol=lf
*.htm text eol=lf

# Markdown
*.md text eol=lf
*.markdown text eol=lf

# Configuration files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# ===========================================
# Git LFS (Large File Storage)
# ===========================================
# Track large files with Git LFS
*.psd filter=lfs diff=lfs merge=lfs -text
*.ai filter=lfs diff=lfs merge=lfs -text
*.sketch filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.avi filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text

# ===========================================
# Database Files
# ===========================================
# Treat database files as binary
*.db binary
*.sqlite binary
*.sqlite3 binary

# ===========================================
# Documentation
# ===========================================
# Ensure documentation files have consistent line endings
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# ===========================================
# Scripts
# ===========================================
# Shell scripts should use LF
*.sh text eol=lf

# Windows batch files should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell scripts should use CRLF on Windows
*.ps1 text eol=crlf
