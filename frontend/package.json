{
  "name": "alphaquote",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.16.2",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "framer-motion": "^12.23.22",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.544.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.6",
    "prisma": "^6.16.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.63.0",
    "react-router-dom": "^6.8.0",
    "react-scripts": "5.0.1",
    "tesseract.js": "^6.0.1",
    "zod": "^4.1.11"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "scraper": "node server/scraper.js",
    "api": "node server/api.js",
    "start-all": "node start-alphaquote.js",
    "setup": "node setup-services.js",
    "verify": "node verify-services.js",
    "serpapi-setup": "echo 'SerpAPI Setup: Get your free API key at https://serpapi.com/' && echo 'Set SERPAPI_KEY environment variable or edit server/scraper.js'",
    "db:seed": "node prisma/seed.js",
    "db:reset": "npx prisma migrate reset --force && npm run db:seed",
    "dev": "concurrently \"npm run scraper\" \"npm run api\" \"npm start\"",
    "production": "npm run build && serve -s build -l 3000"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.14",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "postcss": "^8.4.21",
    "tailwindcss": "^3.3.0"
  }
}
