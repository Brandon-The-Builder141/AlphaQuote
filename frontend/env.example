# ===========================================
# AlphaQuote Frontend Configuration
# ===========================================

# App Version
REACT_APP_VERSION=3.0.0

# Backend API URL
REACT_APP_API_URL=http://localhost:3001

# Price Scraper Service URL (Optional)
REACT_APP_SCRAPER_URL=http://localhost:5050

# Authentication (Clerk)
# Get your keys from: https://clerk.com
# For development, placeholder keys work fine
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Optional: Stripe (for Pro subscription features)
# Get your keys from: https://stripe.com
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here

# ===========================================
# REMOVED / DEPRECATED VARIABLES
# ===========================================
# These are NO LONGER USED in this version:
# - REACT_APP_CATALOG_API_URL (Catalog removed)
# - REACT_APP_GROK_API_KEY (Catalog removed)
# - REACT_APP_OPENAI_KEY (Using local AI only)
