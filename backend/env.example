# ===========================================

# AlphaQuote Backend Configuration

# ===========================================



# API Server

API_PORT=3001

FRONTEND_URL=http://localhost:3000



# Price Scraper Service (Pass Seven contract)

# The scraper is a separate service that ONLY the API calls,
# server-to-server. The API needs its URL + the shared secret; the
# scraper service itself needs the secret + the SerpAPI key.
# Without them, price lookups degrade honestly (no live prices) —
# everything else works.

# --- On the API service:
SCRAPER_SERVICE_URL=http://localhost:5050
SCRAPER_SHARED_SECRET=<redacted>

# --- On the scraper service (backend/server/scraper.js):
SCRAPER_PORT=5050
SERPAPI_KEY=
# SCRAPER_SHARED_SECRET must match the API's value.

# Optional timeouts (ms)
# SCRAPER_TIMEOUT_MS=15000   (API -> scraper)
# SERPAPI_TIMEOUT_MS=10000   (scraper -> SerpAPI)



# Database (SQLite local file)

DATABASE_URL=file:./dev.db



# Authentication (Clerk)

# Get your keys from: https://clerk.com

CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here



# Clerk webhook signing secret (from the Clerk dashboard webhook endpoint;

# used to verify user.created/user.updated deliveries to /api/webhooks/clerk)

CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret_here



# Email Configuration (Optional - for sending quotes and reminders)

EMAIL_ENABLED=false

EMAIL_HOST=smtp.gmail.com

EMAIL_PORT=587

EMAIL_USER=your-email@gmail.com

EMAIL_PASS=your-app-password

EMAIL_FROM=AlphaQuote <noreply@alphaquote.com>



# Stripe (Optional - for Pro subscription features)

# Get your keys from: https://stripe.com

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here



# Development

NODE_ENV=development

DEBUG=true

LOG_LEVEL=info



# ===========================================

# REMOVED / DEPRECATED VARIABLES

# ===========================================

# These are NO LONGER USED in this version:

# - GROK_API_KEY (Material catalog removed)

# - CATALOG_PORT (Material catalog removed)

# - OPENAI_API_KEY (Using local AI only)

# - ANTHROPIC_API_KEY (Using local AI only)

# - SERPAPI_KEY (Optional, not required)

