// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "REMOVED_LOCAL_SECRET"
}

// Local vendor/supplier information
model LocalVendor {
  id         String   @id @default(cuid())
  name       String
  contact    String?   // Phone number or email
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  materials  Material[] // Optional future link
  
  // Relations
  prices        LocalVendorPrice[]
  tasks         Task[]
  receipts      Receipt[]
  
  // Multi-user relationships
  contractorAccount   ContractorAccount? @relation(fields: [contractorAccountId], references: [id], onDelete: Cascade)
  contractorAccountId String?
  createdBy           User?             @relation(fields: [createdById], references: [id])
  createdById         String?
}

// Material catalog (optional future feature)
model Material {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  unit        String?   // "sqft", "piece", "gallon", etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  vendors     LocalVendor[]
}

// Vendor-specific pricing for materials
model LocalVendorPrice {
  id           String      @id @default(cuid())
  vendor       LocalVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId     String
  materialKey  String      // normalized name, e.g. "joint_compound"
  materialName String      // original name for display
  unitPrice    Decimal
  unitLabel    String      // "bag", "sheet", "gal", etc.
  category     String?     @default("General")
  confidence   Float       @default(1.0)
  lastUpdated  DateTime    @default(now())
  receiptId    String?

  // Relations
  receipt      Receipt?    @relation(fields: [receiptId], references: [id])

  @@unique([vendorId, materialKey])
}

// Receipt storage and processing
model Receipt {
  id           String             @id @default(cuid())
  vendor       LocalVendor        @relation(fields: [vendorId], references: [id])
  vendorId     String
  receiptDate  DateTime
  uploadDate   DateTime           @default(now())
  total        Decimal
  subtotal     Decimal?
  tax          Decimal?
  category     String?            @default("General")
  project      String?            // Legacy field - keeping for backward compatibility
  projectId    String?            // New field for proper project relation
  ocrConfidence Float             @default(0.0)
  verified     Boolean            @default(false)
  
  // File information
  fileName     String?
  fileSize     Int?
  mimeType     String?
  
  // Relations
  items        ReceiptItem[]
  prices       LocalVendorPrice[]
  projectRef   Project?           @relation(fields: [projectId], references: [id])
  
  // Multi-user relationships
  contractorAccount   ContractorAccount? @relation(fields: [contractorAccountId], references: [id], onDelete: Cascade)
  contractorAccountId String?
  createdBy           User?             @relation(fields: [createdById], references: [id])
  createdById         String?
}

// Individual items from receipts
model ReceiptItem {
  id          String   @id @default(cuid())
  receipt     Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  receiptId   String
  description String
  category    String?
  quantity    Decimal
  unit        String
  unitPrice   Decimal
  totalPrice  Decimal
  sku         String?
  confidence  Float    @default(0.0)
}

// Project tasks with optional vendor associations
model Task {
  id             String       @id @default(cuid())
  name           String
  description    String?
  estimatedCost  Decimal      @default(0)
  actualCost     Decimal      @default(0)
  status         String       @default("pending")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  // Optional vendor association
  localVendorId  String?
  localVendor    LocalVendor? @relation(fields: [localVendorId], references: [id])
  
  // Project association
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id])
}

// Project management
model Project {
  id           String   @id @default(cuid())
  name         String
  clientName   String?
  clientEmail  String?
  clientPhone  String?
  address      String?
  jobType      String?
  description  String?
  timeline     String?
  budget       String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  tasks        Task[]
  estimates    Estimate[]
  receipts     Receipt[]
  scheduledJobs ScheduledJob[]
  
  // Multi-user relationships
  contractorAccount   ContractorAccount? @relation(fields: [contractorAccountId], references: [id], onDelete: Cascade)
  contractorAccountId String?
  createdBy           User?             @relation(fields: [createdById], references: [id])
  createdById         String?
}

// Estimate history
model Estimate {
  id           String   @id @default(cuid())
  project      Project  @relation(fields: [projectId], references: [id])
  projectId    String
  estimateType String   // "manual", "ai", "hybrid"
  totalCost    Decimal
  markup       Decimal  @default(15)
  createdAt    DateTime @default(now())
  
  // Estimate data (JSON)
  roomData     String?  // JSON string of room details
  aiResponse   String?  // AI-generated estimate text
  pdfPath      String?  // Path to generated PDF
  
  // Relations
  scheduledJobs ScheduledJob[]
  
  // Multi-user relationships
  contractorAccount   ContractorAccount? @relation(fields: [contractorAccountId], references: [id], onDelete: Cascade)
  contractorAccountId String?
  createdBy           User?             @relation(fields: [createdById], references: [id])
  createdById         String?
}

// Regional material price packs
model RegionalPricePack {
  id          String   @id @default(cuid())
  name        String   // e.g., "Northeast", "Southeast", "West Coast"
  region      String   // e.g., "US-NE", "US-SE", "US-WC"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  materials   RegionalMaterial[]
  userSelections UserRegionalSelection[]
}

// Materials within regional price packs
model RegionalMaterial {
  id                String            @id @default(cuid())
  pricePack         RegionalPricePack @relation(fields: [pricePackId], references: [id], onDelete: Cascade)
  pricePackId       String
  materialKey       String            // normalized key, e.g., "luxury_vinyl_plank"
  materialName      String            // display name, e.g., "Luxury Vinyl Plank Flooring"
  category          String            // e.g., "Flooring", "Paint", "Electrical"
  unit              String            // e.g., "sqft", "gallon", "piece"
  unitPrice         Decimal           // price per unit
  unitLabel         String            // display unit, e.g., "per sq ft", "per gallon"
  description       String?           // additional details
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  @@unique([pricePackId, materialKey])
}

// User's regional price pack selection
model UserRegionalSelection {
  id          String            @id @default(cuid())
  userId      String?           // optional user identification
  pricePack   RegionalPricePack @relation(fields: [pricePackId], references: [id])
  pricePackId String
  isDefault   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  
  @@unique([userId])
}

// Task templates for quick insertion
model TaskTemplate {
  id          String   @id @default(cuid())
  name        String   // template name, e.g., "Kitchen Remodel - Basic"
  description String?  // template description
  category    String?  // e.g., "Kitchen", "Bathroom", "General"
  isPublic    Boolean  @default(false) // whether template is shared
  userId      String?  // optional user identification
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  tasks       TaskTemplateItem[]
  
  // Multi-user relationships
  contractorAccount   ContractorAccount? @relation(fields: [contractorAccountId], references: [id], onDelete: Cascade)
  contractorAccountId String?
  createdBy           User?             @relation(fields: [createdById], references: [id])
  createdById         String?
}

// Individual tasks within a template
model TaskTemplateItem {
  id           String       @id @default(cuid())
  template     TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId   String
  name         String       // task name
  description  String?      // task description
  category     String?      // task category
  unit         String?      // measurement unit
  quantity     Decimal?     @default(1) // default quantity
  unitPrice    Decimal?     // default unit price
  totalPrice   Decimal?     // calculated total (quantity * unitPrice)
  sortOrder    Int          @default(0) // for ordering tasks within template
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// Follow-up reminders for quotes
model FollowUpReminder {
  id          String   @id @default(cuid())
  projectId   String?  // optional link to project
  clientEmail String   // recipient email
  clientName  String?  // recipient name
  subject     String   // email subject
  message     String   // email message content
  scheduledDate DateTime // when to send the follow-up
  status      String   @default("pending") // pending, sent, cancelled
  sentDate    DateTime? // when it was actually sent
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  template    FollowUpTemplate? @relation(fields: [templateId], references: [id])
  templateId  String?
}

// Email templates for follow-ups
model FollowUpTemplate {
  id          String   @id @default(cuid())
  name        String   // template name
  subject     String   // email subject template
  message     String   // email message template
  isDefault   Boolean  @default(false) // default template for user
  userId      String?  // optional user identification
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  followUps   FollowUpReminder[]
  
  // Multi-user relationships
  contractorAccount   ContractorAccount? @relation(fields: [contractorAccountId], references: [id], onDelete: Cascade)
  contractorAccountId String?
  createdBy           User?             @relation(fields: [createdById], references: [id])
  createdById         String?
}

// Team/Contractor accounts
model ContractorAccount {
  id          String   @id @default(cuid())
  name        String   // company/contractor name
  email       String   @unique // primary contact email
  phone       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  users       User[]
  projects    Project[]
  receipts    Receipt[]
  vendors     LocalVendor[]
  estimates   Estimate[]
  followUpTemplates FollowUpTemplate[]
  taskTemplates TaskTemplate[]
  scheduledJobs ScheduledJob[]
  scheduledJobReminders ScheduledJobReminder[]
  calendarSyncSettings CalendarSyncSettings[]
}

// User accounts within contractor accounts
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  firstName   String
  lastName    String
  password    String   // hashed password
  role        String   @default("viewer") // viewer, editor, admin
  isActive    Boolean  @default(true)
  lastLogin   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  contractorAccount   ContractorAccount @relation(fields: [contractorAccountId], references: [id], onDelete: Cascade)
  contractorAccountId String
  
  // User's created items
  createdProjects     Project[]
  createdReceipts     Receipt[]
  createdVendors      LocalVendor[]
  createdEstimates    Estimate[]
  createdFollowUpTemplates FollowUpTemplate[]
  createdTaskTemplates TaskTemplate[]
  createdScheduledJobs ScheduledJob[]
}

// Project and Estimate models already defined above

// Job Scheduling Models
model ScheduledJob {
  id              String   @id @default(cuid())
  title           String   // job title
  description     String?  // job description
  startDate       DateTime // job start date
  endDate         DateTime // job end date
  startTime       String?  // start time (HH:MM format)
  endTime         String?  // end time (HH:MM format)
  status          String   @default("scheduled") // scheduled, in_progress, completed, cancelled
  priority        String   @default("medium") // low, medium, high, urgent
  location        String?  // job location/address
  notes           String?  // additional notes
  
  // Quote/Project relationship
  project         Project? @relation(fields: [projectId], references: [id])
  projectId       String?
  estimate        Estimate? @relation(fields: [estimateId], references: [id])
  estimateId      String?
  
  // Calendar sync
  googleCalendarEventId String? // Google Calendar event ID
  icalEventId     String? // iCal event ID
  syncStatus      String  @default("none") // none, synced, failed, pending
  lastSyncAt      DateTime?
  
  // Recurrence
  isRecurring     Boolean  @default(false)
  recurrenceRule  String?  // RRULE format for recurring jobs
  recurrenceEnd   DateTime? // end date for recurring jobs
  
  // Reminders
  reminders       ScheduledJobReminder[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Multi-user relationships
  contractorAccount   ContractorAccount? @relation(fields: [contractorAccountId], references: [id], onDelete: Cascade)
  contractorAccountId String?
  createdBy           User?             @relation(fields: [createdById], references: [id])
  createdById         String?
}

// Reminders for scheduled jobs
model ScheduledJobReminder {
  id              String   @id @default(cuid())
  job             ScheduledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId           String
  type            String   // email, sms, push, calendar
  triggerTime     DateTime // when to send reminder
  message         String?  // reminder message
  isSent          Boolean  @default(false)
  sentAt          DateTime?
  createdAt       DateTime @default(now())
  
  // Multi-user relationships
  contractorAccount   ContractorAccount? @relation(fields: [contractorAccountId], references: [id], onDelete: Cascade)
  contractorAccountId String?
}

// Calendar sync settings
model CalendarSyncSettings {
  id              String   @id @default(cuid())
  userId          String?  // optional user identification
  
  // Google Calendar settings
  googleCalendarEnabled Boolean @default(false)
  googleCalendarId      String? // Google Calendar ID
  googleCalendarToken   String? // encrypted access token
  googleCalendarRefreshToken String? // encrypted refresh token
  
  // iCal settings
  icalEnabled     Boolean @default(false)
  icalUrl         String? // iCal feed URL
  icalUsername    String? // iCal username
  icalPassword    String? // encrypted iCal password
  
  // Sync preferences
  autoSync        Boolean @default(true)
  syncFrequency   String  @default("realtime") // realtime, hourly, daily
  syncDirection   String  @default("both") // to_calendar, from_calendar, both
  
  // Notification settings
  emailNotifications Boolean @default(true)
  smsNotifications   Boolean @default(false)
  pushNotifications  Boolean @default(true)
  
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Multi-user relationships
  contractorAccount   ContractorAccount? @relation(fields: [contractorAccountId], references: [id], onDelete: Cascade)
  contractorAccountId String?
}